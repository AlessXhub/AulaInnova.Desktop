<UserControl x:Class="AulaInnova.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource ScrollViewerStyle}">
        <StackPanel Margin="28" MaxWidth="1500" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding RequirementRefs}" Style="{StaticResource CaptionText}" Margin="0,7,0,22" />

            <Border Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Tipo de reporte" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding ReportType}" Style="{StaticResource InputComboBox}" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Período" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Style="{StaticResource InputComboBox}" /></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Ámbito autorizado" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" Style="{StaticResource InputComboBox}" /></StackPanel>
                    <Button Grid.Column="3" Content="Generar reporte" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="14" Margin="0,14,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA39;" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0" /><TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" /></StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0" MinHeight="430">
                <StackPanel>
                    <Grid Margin="22,18">
                        <StackPanel>
                            <TextBlock Text="{Binding ReportType}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding GeneratedAt}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Consulta en sistema" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                            <TextBlock Text="No se promete exportación externa" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="22,0,22,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource BrandBrush}" Margin="10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Context}" Style="{StaticResource CaptionText}" Margin="10,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="9" Padding="13" Margin="22,8,22,20">
                        <TextBlock Text="{Binding FeedbackMessage}" Foreground="{DynamicResource BrandDarkBrush}" FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>
            <Button Content="Simular error del servicio" Command="{Binding SimulateErrorCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
