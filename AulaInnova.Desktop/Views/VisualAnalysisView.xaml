<UserControl x:Class="AulaInnova.Desktop.Views.VisualAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource ScrollViewerStyle}">
        <StackPanel Margin="28" MaxWidth="1500" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding RequirementRefs}" Style="{StaticResource CaptionText}" Margin="0,7,0,20" />

            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="11" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource WarningBrush}" FontSize="17" Margin="0,1,10,0" />
                    <TextBlock Grid.Column="1" Text="Este módulo no almacena imágenes, no identifica personas y no emite juicios automáticos. La interpretación pertenece al docente." Foreground="{DynamicResource WarningBrush}" FontSize="13" FontWeight="Bold" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="Sesión autorizada" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Style="{StaticResource InputComboBox}" /></StackPanel>
                    <Button Grid.Column="1" Content="Cargar sesión" Command="{Binding SelectSessionCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="Simular sin datos" Command="{Binding SimulateUnavailableCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="10" Padding="13" Margin="0,14,0,0">
                <TextBlock Text="{Binding FeedbackMessage}" Foreground="{DynamicResource InfoBrush}" FontSize="12" />
            </Border>

            <Grid Visibility="{Binding HasValidData, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="268" MinHeight="135" Margin="0,0,14,14">
                                    <StackPanel>
                                        <Grid><TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="12" MaxWidth="210" /><TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Right" /></Grid>
                                        <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="ExtraBold" Margin="0,11,0,3" />
                                        <TextBlock Text="{Binding Context}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="Evolución del movimiento observable" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Unidad demostrativa · método MV-0.3 · zona AULA_COMPLETA" Style="{StaticResource CaptionText}" Margin="0,4,0,20" />
                                <ItemsControl ItemsSource="{Binding MovementSeries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,13">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                                <Canvas Grid.Column="1" Height="22" Background="{DynamicResource SurfaceMutedBrush}" ClipToBounds="True">
                                                    <Border Width="{Binding DisplayWidth}" Height="22" Background="{DynamicResource BrandBrush}" CornerRadius="5" />
                                                </Canvas>
                                                <TextBlock Grid.Column="2" Text="{Binding Description}" Style="{StaticResource CaptionText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Contexto declarado" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Práctica guiada de estructuras de datos" FontWeight="Bold" FontSize="14" Margin="0,14,0,4" />
                                    <TextBlock Text="Declarado por Carlos Méndez para el intervalo completo. No altera las mediciones." Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Validez y límites" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="5 de 6 intervalos evaluables. El intervalo 10:55 quedó sin datos suficientes por oclusión y no participa en promedios, máximos ni mínimos." Style="{StaticResource BodyText}" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding HasValidData, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                    <Border Width="54" Height="54" Background="{DynamicResource WarningSoftBrush}" CornerRadius="15" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE783;" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource WarningBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Sesión no evaluable" FontWeight="ExtraBold" FontSize="19" HorizontalAlignment="Center" Margin="0,15,0,6" />
                    <TextBlock Text="No hay muestras válidas suficientes. No se muestran ceros ni conclusiones derivadas." Style="{StaticResource BodyText}" TextAlignment="Center" />
                    <Button Content="Restaurar datos de demostración" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
