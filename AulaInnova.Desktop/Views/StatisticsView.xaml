<UserControl x:Class="AulaInnova.Desktop.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource ScrollViewerStyle}">
        <StackPanel Margin="28" MaxWidth="1500" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding RequirementRefs}" Style="{StaticResource CaptionText}" Margin="0,7,0,22" />

            <Border Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Indicador" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Indicators}" SelectedItem="{Binding Indicator}" Style="{StaticResource InputComboBox}" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Población" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Populations}" SelectedItem="{Binding Population}" Style="{StaticResource InputComboBox}" /></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Período" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Style="{StaticResource InputComboBox}" /></StackPanel>
                    <Button Grid.Column="3" Content="Calcular" Command="{Binding CalculateCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="280" MinHeight="128" Margin="0,0,14,14">
                            <StackPanel>
                                <Grid><TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="12" /><TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Right" /></Grid>
                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="ExtraBold" Margin="0,12,0,3" />
                                <TextBlock Text="{Binding Context}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Distribución" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Los datos inválidos no se incluyen como ceros." Style="{StaticResource CaptionText}" Margin="0,4,0,20" />
                        <ItemsControl ItemsSource="{Binding Distribution}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        <Canvas Grid.Column="1" Height="24" Background="{DynamicResource SurfaceMutedBrush}" ClipToBounds="True">
                                            <Border Width="{Binding DisplayWidth}" Height="24" Background="{DynamicResource BrandBrush}" CornerRadius="6" />
                                        </Canvas>
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" Style="{StaticResource CaptionText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Lectura responsable" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Cada porcentaje muestra su población, período y denominador. Las incidencias se cuentan por registro vigente y no por observación añadida." Style="{StaticResource BodyText}" Margin="0,14,0,0" />
                        <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="10" Padding="14" Margin="0,18,0,0">
                            <TextBlock Text="No se generan puntuaciones de disciplina, personalidad o rendimiento." Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" FontSize="12" />
                        </Border>
                        <TextBlock Text="{Binding LastCalculated}" Style="{StaticResource CaptionText}" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
