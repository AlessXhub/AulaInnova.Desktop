<UserControl x:Class="AulaInnova.Desktop.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer Style="{StaticResource ScrollViewerStyle}">
            <StackPanel Margin="28" MaxWidth="1500" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding RequirementRefs}" Style="{StaticResource CaptionText}" Margin="0,7,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Nueva asignación" Command="{Binding OpenEditorCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="11" Padding="15" Margin="0,22,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource InfoBrush}" Margin="0,1,10,0" />
                        <TextBlock Grid.Column="1" Text="Una asignación no prueba presencia. Los períodos libres tampoco equivalen a disponibilidad física confirmada." Foreground="{DynamicResource InfoBrush}" FontSize="13" />
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="10" Padding="13" Margin="0,12,0,0" Visibility="{Binding FeedbackMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding FeedbackMessage}" Foreground="{DynamicResource SuccessBrush}" FontSize="13" />
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                        <StackPanel>
                            <Grid Margin="20,18,20,12">
                                <TextBlock Text="Jornada vigente" Style="{StaticResource SectionTitle}" />
                                <Button Content="Actualizar" Command="{Binding RefreshCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Right" />
                            </Grid>

                            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" Margin="20">
                                <Border Height="66" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="9" Margin="0,0,0,10" />
                                <Border Height="66" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="9" Margin="0,0,0,10" Opacity="0.7" />
                                <Border Height="66" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="9" Opacity="0.5" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Entries}" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Time}" FontWeight="ExtraBold" FontSize="13" />
                                                    <TextBlock Text="{Binding Day}" Style="{StaticResource CaptionText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0">
                                                    <TextBlock Text="{Binding Subject}" FontWeight="Bold" FontSize="13" />
                                                    <TextBlock Text="{Binding Group}" Style="{StaticResource CaptionText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="10,0">
                                                    <TextBlock Text="{Binding Responsible}" FontSize="12" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Classroom}" Style="{StaticResource CaptionText}" />
                                                </StackPanel>
                                                <Border Grid.Column="3" Style="{StaticResource StatusBadge}" Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}">
                                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Reglas de asignación" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="• Valida clase y responsabilidad vigente.&#x0a;• Rechaza intervalos superpuestos.&#x0a;• Conserva la responsabilidad original.&#x0a;• Separa necesidad, asignación y presencia." Style="{StaticResource BodyText}" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Background="{DynamicResource BrandSoftBrush}">
                            <StackPanel>
                                <TextBlock Text="Prueba de recuperación" FontWeight="Bold" />
                                <TextBlock Text="Compruebe el estado de error sin afectar los datos de la sesión." Style="{StaticResource CaptionText}" Margin="0,5,0,12" />
                                <Button Content="Simular fallo de carga" Command="{Binding SimulateErrorCommand}" Style="{StaticResource SecondaryButton}" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Background="#7A111827" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="10">
            <Border Style="{StaticResource Card}" Width="610" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Crear cuido o sustitución" Style="{StaticResource SectionTitle}" FontSize="21" />
                        <Button Content="&#xE711;" Command="{Binding CloseEditorCommand}" Style="{StaticResource IconButton}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="Use los identificadores visibles al abrir el detalle en Jornadas, Grupos, Personal y Aulas. La API valida vigencia y solapamientos." Style="{StaticResource CaptionText}" Margin="0,7,0,20" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,14"><TextBlock Text="Jornada ID" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><TextBox Text="{Binding Day}" Style="{StaticResource InputTextBox}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,14"><TextBlock Text="Intervalo local" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><TextBox Text="{Binding Time}" Style="{StaticResource InputTextBox}" ToolTip="AAAA-MM-DD HH:mm-HH:mm" /></StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,14"><TextBlock Text="Tipo" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding AssignmentTypes}" SelectedItem="{Binding AssignmentType}" Style="{StaticResource InputComboBox}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,14"><TextBlock Text="Personal ID" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><TextBox Text="{Binding Responsible}" Style="{StaticResource InputTextBox}" /></StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,14"><TextBlock Text="Actividad o motivo" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><TextBox Text="{Binding Subject}" Style="{StaticResource InputTextBox}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,14"><TextBlock Text="Grupo ID" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" /><TextBox Text="{Binding Group}" Style="{StaticResource InputTextBox}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="Aula ID" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Classroom}" Style="{StaticResource InputTextBox}" />
                    <TextBlock Text="{Binding FeedbackMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,12,0,0" Visibility="{Binding FeedbackMessage, Converter={StaticResource StringToVisibility}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Cancelar" Command="{Binding CloseEditorCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                        <Button Content="Validar y asignar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
