<UserControl x:Class="AulaInnova.Desktop.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource ScrollViewerStyle}">
        <StackPanel Margin="28" MaxWidth="1120" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding RequirementRefs}" Style="{StaticResource CaptionText}" Margin="0,7,0,22" />

            <Grid MaxWidth="1060" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="82" Height="82" CornerRadius="41" Background="{DynamicResource BrandBrush}">
                                <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="22" FontWeight="ExtraBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,16,0,4" />
                            <TextBlock Text="{Binding Role}" Foreground="{DynamicResource BrandBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Area}" Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="0,7,0,0" />
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20" />
                            <TextBlock Text="Nombre de usuario" Style="{StaticResource CaptionText}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding UserName}" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Seguridad" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="La autenticación y autorización reales quedan pendientes del servicio Identity y de la API .NET. Esta vista no concede permisos." Style="{StaticResource BodyText}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Datos de contacto" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Correo" FontWeight="Bold" FontSize="12" Margin="0,18,0,6" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" />
                            <TextBlock Text="Teléfono institucional" FontWeight="Bold" FontSize="12" Margin="0,16,0,6" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" />
                            <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="9" Padding="12" Margin="0,14,0,0" Visibility="{Binding FeedbackMessage, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding FeedbackMessage}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" />
                            </Border>
                            <Button Content="Guardar cambios" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Permisos efectivos de demostración" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="La API deberá volver a validar cada acción y ámbito." Style="{StaticResource CaptionText}" Margin="0,4,0,14" />
                            <ItemsControl ItemsSource="{Binding Permissions}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="999" Padding="10,6" Margin="0,0,8,8">
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource BrandDarkBrush}" FontSize="11" FontWeight="Bold" TextWrapping="NoWrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
