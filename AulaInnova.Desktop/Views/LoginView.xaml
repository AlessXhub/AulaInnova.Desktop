<UserControl x:Class="AulaInnova.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1440" d:DesignHeight="900">
    <Grid Background="#E4EBFF" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46*" />
            <ColumnDefinition Width="54*" />
        </Grid.ColumnDefinitions>
        <Image Grid.ColumnSpan="2"
               Source="/Assets/Brand/login-background-v2.png"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"
               IsHitTestVisible="False" />

        <Grid Grid.Column="0" ClipToBounds="True">
            <Grid Margin="56,46,48,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Brand/aula-innova-mark-white.png"
                           Width="68" Height="58" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,5,0,0">
                        <TextBlock Text="AULA INNOVA" Foreground="White" FontSize="18" FontWeight="ExtraBold" />
                        <TextBlock Text="GESTIÓN EDUCATIVA" Foreground="#E9ECFF" FontSize="10" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="410" HorizontalAlignment="Left">
                    <TextBlock Text="Información que converge en mejores decisiones."
                               Foreground="White" FontSize="43" FontWeight="ExtraBold" LineHeight="50" />
                    <Border Width="52" Height="5" CornerRadius="3" Background="{DynamicResource BrandLimeBrush}"
                            HorizontalAlignment="Left" Margin="0,24,0,0" />
                    <TextBlock Margin="0,20,0,0"
                               Text="Gestión educativa clara, trazable y centrada en las personas."
                               Foreground="#F1F3FF" FontSize="16" LineHeight="24" MaxWidth="380" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Cliente institucional  /  API central"
                           Foreground="#E9ECFF" FontSize="11" FontWeight="Medium" />
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Margin="72,38,60,38">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center" MaxWidth="390" HorizontalAlignment="Center">
                    <TextBlock Text="Login" Foreground="{DynamicResource BrandNavyBrush}" FontSize="36" FontWeight="Medium" />
                    <TextBlock Margin="0,8,0,30" Text="Acceda a su espacio de trabajo." Style="{StaticResource BodyText}" />

                    <TextBlock Text="Usuario" FontWeight="Medium" FontSize="12" />
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource LoginTextBox}"
                             AutomationProperties.Name="Usuario" />

                    <TextBlock Text="Contraseña" FontWeight="Medium" FontSize="12" Margin="0,22,0,0" />
                    <PasswordBox x:Name="PasswordInput"
                                 PasswordChanged="PasswordInput_OnPasswordChanged"
                                 Style="{StaticResource LoginPasswordBox}"
                                 AutomationProperties.Name="Contraseña" />

                    <Button Content="¿Olvidó su contraseña?"
                            Command="{Binding ForgotPasswordCommand}"
                            Style="{StaticResource TextButton}"
                            FontSize="11"
                            HorizontalAlignment="Right" Margin="0,7,0,16" />

                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="9" Padding="13"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA39;" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource DangerBrush}" Margin="0,1,10,0" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding SignInCommand}" Style="{StaticResource LoginPrimaryButton}" MinHeight="44">
                        <Grid>
                            <TextBlock Text="Ingresar" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Text="Validando acceso..." Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>

                    <Border Margin="0,28,0,0" Padding="16,14" CornerRadius="14" Background="#66FFFFFF" BorderBrush="#80A3AFF4" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Acceso seguro" FontWeight="Bold" FontSize="12" />
                            <TextBlock Text="Las credenciales se validan mediante ASP.NET Identity. La aplicación conserva el token solo durante la sesión actual." Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
