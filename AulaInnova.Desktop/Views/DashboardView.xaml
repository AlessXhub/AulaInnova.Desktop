<UserControl x:Class="AulaInnova.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource ScrollViewerStyle}">
        <StackPanel Margin="28" MaxWidth="1500" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,6,0,24" />

            <ItemsControl ItemsSource="{Binding Metrics}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="250" MinHeight="148" Margin="0,0,14,14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrandSoftBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFontFamily}" Foreground="{DynamicResource BrandBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Row="1" Margin="0,13,0,8">
                                    <TextBlock Text="{Binding Value}" FontSize="25" FontWeight="ExtraBold" />
                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="{Binding Context}" Style="{StaticResource CaptionText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Actividad reciente" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Operaciones recientes registradas por la API central." Style="{StaticResource CaptionText}" Margin="0,4,0,16" />
                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="4" Background="{Binding Tone, Converter={StaticResource StatusBrushConverter}}" CornerRadius="2" />
                                        <StackPanel Grid.Column="1" Margin="12,0,14,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Text="{Binding Context}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource CaptionText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Asistencia de la jornada" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Distribución calculada con registros persistidos; lo pendiente no equivale a ausencia." Style="{StaticResource CaptionText}" Margin="0,4,0,20" />
                        <ItemsControl ItemsSource="{Binding AttendanceDistribution}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <Grid><TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="12" /><TextBlock Text="{Binding Description}" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" /></Grid>
                                        <Border Height="7" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="4" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                            <Border Width="{Binding DisplayWidth}" MaxWidth="300" Background="{DynamicResource BrandBrush}" CornerRadius="4" HorizontalAlignment="Left" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
