<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:AulaInnova.Desktop.Infrastructure">
    <FontFamily x:Key="AppFontFamily">pack://application:,,,/Assets/Fonts/#Manrope</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons</FontFamily>

    <Color x:Key="BrandNavy">#17233D</Color>
    <Color x:Key="BrandViolet">#5967E9</Color>
    <Color x:Key="BrandVioletDark">#4653C7</Color>
    <Color x:Key="BrandVioletSoft">#EEF0FF</Color>
    <Color x:Key="BrandLime">#D6E85C</Color>
    <Color x:Key="BrandLavender">#A3AFF4</Color>
    <Color x:Key="Canvas">#F6F7FC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceMuted">#F0F2F8</Color>
    <Color x:Key="Border">#DDE1EC</Color>
    <Color x:Key="TextPrimary">#17233D</Color>
    <Color x:Key="TextSecondary">#5E687D</Color>
    <Color x:Key="TextMuted">#7C8597</Color>
    <Color x:Key="Success">#1E7B58</Color>
    <Color x:Key="SuccessSoft">#E9F7F1</Color>
    <Color x:Key="Warning">#A66313</Color>
    <Color x:Key="WarningSoft">#FFF4E4</Color>
    <Color x:Key="Danger">#B83B4B</Color>
    <Color x:Key="DangerSoft">#FDECEF</Color>
    <Color x:Key="Info">#3D5A80</Color>
    <Color x:Key="InfoSoft">#EAF1F8</Color>

    <SolidColorBrush x:Key="BrandNavyBrush" Color="{StaticResource BrandNavy}" />
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandViolet}" />
    <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandVioletDark}" />
    <SolidColorBrush x:Key="BrandSoftBrush" Color="{StaticResource BrandVioletSoft}" />
    <SolidColorBrush x:Key="BrandLimeBrush" Color="{StaticResource BrandLime}" />
    <SolidColorBrush x:Key="BrandLavenderBrush" Color="{StaticResource BrandLavender}" />
    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="{StaticResource Canvas}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMuted}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoft}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoft}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoft}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoft}" />

    <infra:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <infra:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True" />
    <infra:StringToVisibilityConverter x:Key="StringToVisibility" />
    <infra:StringToVisibilityConverter x:Key="InverseStringToVisibility" Inverse="True" />
    <infra:StatusBrushConverter x:Key="StatusBrushConverter" />
</ResourceDictionary>
